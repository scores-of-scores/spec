{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scores-of-scores:schema:profile:2",
  "title": "Profile of the Transcription Principles",
  "description": "A project's choices over the core registry: strength of each rule, ranked aims, resolution of tensions, and scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "title",
    "status",
    "principles_version",
    "strengths",
    "precedence",
    "scope"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "principles_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "notes": {
      "type": "string",
      "description": "Path or URL of the local notes."
    },
    "strengths": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "enum": [
          "MUST",
          "SHOULD",
          "MAY",
          "OFF"
        ]
      }
    },
    "aim_order": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "over",
          "under",
          "reason"
        ],
        "properties": {
          "over": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "under": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "scope": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unsupported_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marks": {
          "type": "object",
          "description": "Reclassify categories of printed mark from the core registry (mark_categories). Categories not listed keep their core default.",
          "propertyNames": {
            "pattern": "^[a-z]+(-[a-z]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "treatment"
            ],
            "properties": {
              "treatment": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "dialect",
            "accept_extensions"
          ],
          "description": "The encoding format of the version of record. Mark categories classed as unsupported are derived relative to it.",
          "properties": {
            "format": {
              "enum": [
                "krn",
                "musicxml",
                "musescore",
                "mei"
              ]
            },
            "dialect": {
              "type": "string",
              "minLength": 1,
              "description": "The exact dialect, version and extensions in use."
            },
            "accept_extensions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^fmt\\.[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "description": "Features whose \"extension\" status the profile accepts, so that they count as expressible."
            }
          }
        }
      },
      "required": [
        "encoding"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "adopted"
      ],
      "description": "draft: strengths not yet confirmed by the project the profile describes."
    },
    "basis": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Where a strength, precedence or aim comes from. A rule without an entry is a default taken from the core, not a documented choice.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
