{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scores-of-scores:schema:glossary:1",
  "title": "Glossary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "terms"
  ],
  "properties": {
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "meaning"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "not": {
            "type": "string"
          }
        }
      }
    }
  }
}
