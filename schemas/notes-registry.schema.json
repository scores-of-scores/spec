{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scores-of-scores:schema:notes-registry:1",
  "title": "Notes for Transcribers: registry of local notes",
  "description": "Local notes, identified as <area>.<slug>. A note may link to the core rules it applies. Cross-checks (areas exist and do not reuse core domains, applies targets exist, aliases unique, presentation notes apply only permitted normalisations) are done by tools/build.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notes_version",
    "title",
    "profile",
    "kinds",
    "areas",
    "notes"
  ],
  "properties": {
    "notes_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "title": {
      "type": "string"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kinds": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string"
      }
    },
    "areas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "not_yet_covered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "kind",
        "title",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "area": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "presentation",
            "tool",
            "house",
            "editorial"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "situation",
              "handling"
            ],
            "properties": {
              "situation": {
                "type": "string"
              },
              "handling": {
                "type": "string"
              }
            }
          }
        },
        "applies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "active",
            "retired",
            "proposed"
          ],
          "default": "active"
        }
      }
    }
  }
}
