{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scores-of-scores:schema:principles-registry:1",
  "title": "Transcription Principles: core registry",
  "description": "The adoptable core. Rules are identified as <domain>.<slug>; IDs are permanent. Strengths and priorities are not set here: they belong to a profile. Cross-checks (domains and themes exist, relation targets exist, aliases unique) are done by tools/build.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principles_version",
    "title",
    "tiers",
    "domains",
    "themes",
    "treatments",
    "mark_categories",
    "rules"
  ],
  "properties": {
    "principles_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "title": {
      "type": "string"
    },
    "tiers": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "test"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "test": {
            "type": "string"
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "themes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]+(-[a-z]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "title"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "mark_categories": {
      "type": "object",
      "minProperties": 1,
      "description": "Categories of printed mark that are classed by tier rather than transcribed by default. A profile may reclassify them (scope.marks).",
      "propertyNames": {
        "pattern": "^[a-z]+(-[a-z]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "default_treatment"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "default_treatment": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "treatments": {
      "type": "object",
      "minProperties": 3,
      "description": "How a category of printed mark is treated: transcribed, left to editorial work, or outside what the encoding format expresses.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "meaning"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "theme",
        "kind",
        "title",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "theme": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "obligation",
            "permission"
          ],
          "description": "obligation: a do or don't. permission: a registered presentation normalisation."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "Strength-neutral imperative. The profile supplies MUST, SHOULD, MAY or OFF."
        },
        "rationale": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "situation",
              "handling"
            ],
            "properties": {
              "situation": {
                "type": "string"
              },
              "handling": {
                "type": "string"
              }
            }
          }
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refines": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "exception-of": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "tension-with": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "see-also": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            }
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Earlier codes, kept for traceability."
        },
        "status": {
          "enum": [
            "active",
            "retired",
            "proposed"
          ],
          "default": "active"
        },
        "retired_on": {
          "type": "string",
          "format": "date"
        },
        "replaced_by": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "retired"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "retired_on",
              "replaced_by"
            ]
          }
        }
      ]
    }
  }
}
